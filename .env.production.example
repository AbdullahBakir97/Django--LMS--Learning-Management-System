# Copy to .env.production and fill in. Never commit the real file.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=          # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=lms.example.com
CSRF_TRUSTED_ORIGINS=https://lms.example.com
CORS_ALLOWED_ORIGINS=https://lms.example.com
FRONTEND_URL=https://lms.example.com
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=          # a long random password
JWT_COOKIE_SECURE=1
DEFAULT_FROM_EMAIL=LMS <no-reply@lms.example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
LOG_LEVEL=INFO
# Optional rate limits (requests per client): THROTTLE_ANON, THROTTLE_USER, THROTTLE_AUTH
WEB_PORT=80
