# Base URL of the API as the browser sees it. In development Vite proxies /api to the backend.
VITE_API_URL=/api
# Where the dev proxy forwards /api and /ws.
VITE_BACKEND_URL=http://localhost:8000
# WebSocket base for live notifications. Defaults to ws(s)://<this host>/ws, proxied in development.
# VITE_WS_URL=wss://api.example.com/ws
